@* View nhận danh sách Product từ ProductsController.Index() *@
@model IEnumerable<DBSportStore.Models.Product>

@{
    // Tiêu đề trang
    ViewBag.Title = "Quản lý sản phẩm";

    // Dùng giao diện chung của SportStore
    Layout = "~/Views/Shared/_StoreLayout.cshtml";
}

<h2 class="section-title">QUẢN LÝ SẢN PHẨM</h2>

<p>
    @* Liên kết tới action Create để thêm sản phẩm mới *@
    @Html.ActionLink(
        "Thêm sản phẩm mới",
        "Create",
        null,
        new { @class = "btn-brand" })
</p>

<!-- Cho phép cuộn ngang khi bảng rộng -->
<div style="overflow-x:auto;">
    <table class="table table-bordered table-hover"
           style="background:white; vertical-align:middle;">
        <thead>
            <tr>
                <th>Hình</th>
                <th>Tên sản phẩm</th>
                <th>Danh mục</th>
                <th>Đơn giá</th>
                <th>Tồn kho</th>
                <th>Trạng thái</th>
                <th>Thao tác</th>
            </tr>
        </thead>

        <tbody>
            @* Duyệt từng Product trong Model *@
            @foreach (var item in Model)
            {
                <tr>
                    <td style="width:100px;">
                        @* Chỉ hiển thị ảnh khi có tên file *@
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <!-- Đường dẫn ảnh = Content/images + ImageUrl -->
                            <img src="~/Content/images/@item.ImageUrl"
                                 alt="@item.ProductName"
                                 style="width:80px;
                                    height:80px;
                                    object-fit:cover;
                                    border-radius:10px;" />
                        }
                    </td>

                    <td>
                        <!-- Tên sản phẩm -->
                        <strong>@item.ProductName</strong>
                        <br />

                        <!-- Mô tả sản phẩm -->
                        <span styleh="color:#64748b;font-size:13px;">
                            @item.Description
                        </span>
                    </td>

                    <!-- Lấy tên Category qua quan hệ Product -> Category -->
                    <td>@item.Category.CategoryName</td>

                    <td>
                        <!-- Định dạng giá có dấu phân cách hàng nghìn -->
                        <strong style="color:#dc2626;">
                            @item.Price.ToString("#,##0") đ
                        </strong>
                    </td>

                    <!-- Số lượng tồn kho -->
                    <td>@item.StockQuantity</td>

                    <td>
                        @* true -> Đang bán, false -> Ngừng bán *@
                        @(item.IsActive ? "Đang bán" : "Ngừng bán")
                    </td>

                    <td style="white-space:nowrap;">
                        @* Truyền ProductID sang từng action *@
                        @Html.ActionLink("Sửa", "Edit",
                            new { id = item.ProductID }) |

                        @Html.ActionLink("Chi tiết", "Details",
                            new { id = item.ProductID }) |

                        @Html.ActionLink("Xóa", "Delete",
                            new { id = item.ProductID })
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
