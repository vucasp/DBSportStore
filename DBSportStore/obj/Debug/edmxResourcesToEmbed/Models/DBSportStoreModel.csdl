    </Key>
    <Property Name="OrderID" Type="Int32" Nullable="false" annotation:StoreGeneratedPattern="Identity" />
    <Property Name="OrderDate" Type="DateTime" Nullable="false" Precision="7" />
    <Property Name="CustomerID" Type="Int32" Nullable="false" />
    <Property Name="ShippingAddress" Type="String" Nullable="false" MaxLength="250" FixedLength="false" Unicode="true" />
    <Property Name="TotalAmount" Type="Decimal" Nullable="false" Precision="18" Scale="2" />
    <Property Name="Status" Type="String" Nullable="false" MaxLength="30" FixedLength="false" Unicode="true" />
    <Property Name="RecipientName" Type="String" MaxLength="100" FixedLength="false" Unicode="true" />
    <Property Name="ShippingPhone" Type="String" MaxLength="20" FixedLength="false" Unicode="true" />
    <NavigationProperty Name="Customer" Relationship="DBSportStoreModel.FK_OrderPro_Customer" FromRole="OrderPro" ToRole="Customer" />
    <NavigationProperty Name="OrderDetails" Relationship="DBSportStoreModel.FK_OrderDetail_OrderPro" FromRole="OrderPro" ToRole="OrderDetail" />
  </EntityType>
  <Association Name="FK_OrderPro_Customer">
    <End Type="DBSportStoreModel.Customer" Role="Customer" Multiplicity="1" />
    <End Type="DBSportStoreModel.OrderPro" Role="OrderPro" Multiplicity="*" />
    <ReferentialConstraint>
